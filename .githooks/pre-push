#!/bin/sh

# pre-push: bloquea el push directo a las ramas principales (master/main).
# Obliga a usar ramas de trabajo y Pull Request.

PROTECTED_BRANCHES="master main"

while read local_ref local_sha remote_ref remote_sha; do
  remote_branch=$(echo "$remote_ref" | sed 's#refs/heads/##')
  for protected in $PROTECTED_BRANCHES; do
    if [ "$remote_branch" = "$protected" ]; then
      echo ""
      echo "==========================================================="
      echo "  [BLOQUEADO] Push directo a la rama '$protected' no permitido."
      echo ""
      echo "  Para revisar el codigo antes de subir, usa una rama propia:"
      echo "    git checkout -b feat/tu-avance"
      echo "    git add ."
      echo "    git commit -m 'tu mensaje'"
      echo "    git push -u origin feat/tu-avance"
      echo ""
      echo "  Luego crea un Pull Request en GitHub desde esa rama."
      echo "==========================================================="
      echo ""
      exit 1
    fi
  done
done

exit 0

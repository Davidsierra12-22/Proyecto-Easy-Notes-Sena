# ==========================================================
# EasyNotes v2 - Configuracion del SERVIDOR (plantilla)
# Copia este archivo a ".env" y reemplaza los valores:
#   cp .env.example .env
# NUNCA subas el archivo .env real a git.
# ==========================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Base de datos ---
# Local:  mongodb://localhost:27017/easynots
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/easynots
MONGODB_URI=mongodb://localhost:27017/easynots

# --- Autenticacion (JWT) ---
# OBLIGATORIO en produccion. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Si no se define, el servidor NO arranca (ver src/middleware/auth.js).
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-64-caracteres
JWT_EXPIRES_IN=8h

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# --- CORS ---
# NUNCA uses "*" en produccion: permite que cualquier sitio llame a la API.
# Debe ser el dominio exacto del frontend, separado por coma si hay varios.
CORS_ORIGIN=http://localhost:5173

# --- Pasarela de pagos (Wompi) ---
# Los certificados y llaves de prueba viven en el portal de Wompi.
WOMPI_SANDBOX=true
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=

# --- Frontend (para redirecciones y enlaces de recuperacion) ---
FRONTEND_URL=http://localhost:5173

# --- Envio de correo (Resend) ---
# Sin esta clave el sistema funciona, pero no envia correos y las
# credenciales se muestran en pantalla para entregarlas a mano.
# Registrate en https://resend.com
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
